---
import { Image } from 'astro:assets';
import profileImg from '../assets/images/Head_Shot.jpg';
---

<section class="min-h-[85vh] flex items-center pt-16">
  <div class="max-w-6xl mx-auto px-6 w-full">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      
      <!-- Left: Text content -->
      <div class="space-y-6">
        <div class="flex items-center gap-2 text-neutral-400 text-sm font-mono">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
          Calgary, AB
        </div>

        <h1 class="text-5xl md:text-6xl lg:text-7xl font-display leading-[0.95] tracking-tight">
          Lennart<br/>Kane
        </h1>

        <p class="text-lg text-neutral-500 max-w-md leading-relaxed">
          Mechatronics Engineering student at the <span class="text-neutral-950 font-medium">University of Waterloo</span>. 
          Building things that move, sense, and automate.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a href="/#projects" class="btn-primary">
            View Projects
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17l9.2-9.2M17 17V8H8"/>
            </svg>
          </a>
          <a href="/Lennart_Kane_Resume.pdf" target="_blank" rel="noopener noreferrer" class="btn-outline">
            Resume
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
          </a>
        </div>
        <a href="/about" class="inline-flex items-center gap-2 mt-2 px-5 py-2.5 border border-neutral-200 text-neutral-500 text-sm font-medium rounded-lg transition-all duration-200 hover:border-neutral-950 hover:text-neutral-950 hover:gap-3">
          About Me
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Right: Profile image placeholder -->
      <div class="relative">
        <div class="aspect-[4/5] rounded-3xl bg-neutral-100 border border-neutral-200 overflow-hidden">
          <Image src={profileImg} alt="Lennart Kane" widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" quality={85} class="w-full h-full object-cover" loading="eager" />
        </div>
        <!-- Decorative element -->
        <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-neutral-950 rounded-2xl -z-10"></div>
      </div>
    </div>
  </div>
</section>
