---

<section id="skills" class="pt-16 pb-10 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <p class="section-heading animate-on-scroll">Technical Skills</p>
  </div>

  <div class="relative">
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

    <div id="skills-ticker" class="ticker-track cursor-grab select-none">
      {[...skills, ...skills].map((skill) => (
        <div class="flex-shrink-0 mx-2.5">
          <div class="flex items-center gap-4 px-5 py-4 bg-white border border-neutral-150 rounded-2xl hover:border-neutral-300 hover:shadow-sm transition-all min-w-max">
            <div
              class="w-12 h-12 rounded-xl flex items-center justify-center"
              style={`background: ${skill.color}12; color: ${skill.color};`}
            >
              <div class="w-6 h-6" set:html={skill.icon} />
            </div>
            <div>
              <div class="text-base font-medium text-neutral-900">{skill.name}</div>
              <div class="text-sm text-neutral-400">{skill.category}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const ticker = document.getElementById('skills-ticker');
  if (ticker) {
    let position = 0;
    const autoSpeed = -50;
    let isDragging = false;
    let startX = 0;
    let scrollStart = 0;
    let velocity = 0;
    let lastX = 0;
    let lastTime = 0;
    let prevFrame = performance.now();

    const halfWidth = ticker.scrollWidth / 2;

    function wrapPosition() {
      if (position <= -halfWidth) position += halfWidth;
      if (position > 0) position -= halfWidth;
    }

    function animate(now: number) {
      const dt = Math.min((now - prevFrame) / 1000, 0.1);
      prevFrame = now;

      if (!isDragging) {
        velocity += (autoSpeed - velocity) * (1 - Math.pow(0.03, dt));
        position += velocity * dt;
      }

      wrapPosition();
      ticker.style.transform = `translateX(${position}px)`;
      requestAnimationFrame(animate);
    }

    function onPointerDown(e: PointerEvent) {
      isDragging = true;
      startX = e.clientX;
      scrollStart = position;
      lastX = e.clientX;
      lastTime = Date.now();
      velocity = 0;
      ticker.classList.replace('cursor-grab', 'cursor-grabbing');
      ticker.setPointerCapture(e.pointerId);
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;
      const now = Date.now();
      const dt = (now - lastTime) / 1000;
      if (dt > 0) {
        const pxPerSec = (e.clientX - lastX) / dt;
        velocity = pxPerSec * 0.6 + velocity * 0.4;
        lastX = e.clientX;
        lastTime = now;
      }
      position = scrollStart + (e.clientX - startX);
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      ticker.classList.replace('cursor-grabbing', 'cursor-grab');
      ticker.releasePointerCapture(e.pointerId);
    }

    ticker.addEventListener('pointerdown', onPointerDown);
    ticker.addEventListener('pointermove', onPointerMove);
    ticker.addEventListener('pointerup', onPointerUp);
    ticker.addEventListener('pointercancel', onPointerUp);

    requestAnimationFrame(animate);
  }
</script>
