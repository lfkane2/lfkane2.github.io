---
import { Image } from 'astro:assets';
import sputterImg from '../assets/images/sputter.jpg';
import irrigationImg from '../assets/images/irrigation.jpg';
import weldloggerImg from '../assets/images/weldtrigger.jpg';
import goKartImg from '../assets/images/go-kart.jpg';

const projects = [
  {
    title: "Farm Irrigation System",
    subtitle: "Automated Distributed Sensor Network",
    description: "Solar-powered sensor network using ESP32 microcontrollers with LoRa radios for remote soil monitoring and automated watering control via Raspberry Pi hub.",
    tags: ["ESP32", "LoRa", "Raspberry Pi", "Solar"],
    date: "April 2026 – Present",
    link: "/projects/irrigation",
    image: irrigationImg,
  },
  {
    title: "WeldLogger",
    subtitle: "Weld Current Data Acquisition",
    description: "Custom data acquisition system for capturing and analyzing weld current waveforms in a manufacturing R&D environment.",
    tags: ["C++", "Embedded Systems", "Signal Processing"],
    date: "Jan – Apr 2026",
    link: "/projects/weldlogger",
    image: weldloggerImg,
  },
  {
    title: "Sputter",
    subtitle: "Autonomous Pancake-Making Robot",
    description: "Fully autonomous robot that dispenses, cooks, flips, and plates pancakes with 92% consistency. Features a pneumatic batter system and custom 3-axis Cartesian gantry.",
    tags: ["SolidWorks", "C++", "3D Printing", "Pneumatics"],
    date: "November 2025",
    link: "/projects/sputter",
    image: sputterImg,
  },
  {
    title: "Electric Go Kart",
    subtitle: "Custom-Built EV",
    description: "Designed and built an electric go kart from scratch using shop tools, flux-cored arc welding, and Fusion 360 for CAD modeling.",
    tags: ["Fusion 360", "Welding", "Fabrication"],
    date: "2018",
    link: "/projects/go-kart",
    image: goKartImg,
  },
];
---

<section id="projects" class="py-16">
  <div class="max-w-6xl mx-auto px-6">
    <p class="section-heading animate-on-scroll">Projects</p>

    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project, i) => (
        <a href={project.link} class="card group animate-on-scroll" style={`animation-delay: ${i * 100}ms`}>
          <div class="aspect-video bg-neutral-100 relative overflow-hidden">
            <Image src={project.image} alt={project.title} widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" quality={85} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-neutral-950/0 group-hover:bg-neutral-950/5 transition-colors duration-300"></div>
          </div>

          <div class="p-6">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-xl font-medium group-hover:text-neutral-700 transition-colors">{project.title}</h3>
                <p class="text-sm text-neutral-400">{project.subtitle}</p>
              </div>
              <svg class="w-5 h-5 text-neutral-300 group-hover:text-neutral-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17l9.2-9.2M17 17V8H8"/>
              </svg>
            </div>
            
            <p class="text-sm text-neutral-500 leading-relaxed mb-4">{project.description}</p>
            
            <div class="flex items-center justify-between">
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-xs font-mono bg-neutral-100 text-neutral-500 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
              <span class="text-xs text-neutral-400 font-mono shrink-0 ml-4">{project.date}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
